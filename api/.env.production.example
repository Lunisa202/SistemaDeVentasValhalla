# ============================================================
# Production Environment — Supabase
# ============================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit the actual .env.production file.

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Find these in: Supabase Dashboard → Settings → Database → Connection string
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-supabase-db-password
# Supabase requires SSL
DB_SSL=true

# ─── Authentication (JWT) ────────────────────────────────────
# Generate secure secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=generate-a-strong-random-secret-at-least-64-chars
JWT_REFRESH_SECRET=generate-a-different-strong-random-secret-at-least-64-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
