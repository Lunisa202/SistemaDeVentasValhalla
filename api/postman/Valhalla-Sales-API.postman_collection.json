{
  "info": {
    "name": "Valhalla Sales API",
    "description": "Colección de pruebas para la API del Sistema de Ventas Valhalla",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "purchaseId", "value": "" },
    { "key": "saleId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  console.log('Token guardado correctamente');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@valhalla.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Usa la cookie httpOnly del login. En Postman, las cookies se envían automáticamente si el dominio coincide."
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Catalog (público)",
      "item": [
        {
          "name": "GET /catalog/roles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalog/roles"
          }
        },
        {
          "name": "GET /catalog/document-types",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalog/document-types"
          }
        },
        {
          "name": "GET /catalog/payment-methods",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalog/payment-methods"
          }
        },
        {
          "name": "GET /catalog/categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/catalog/categories"
          }
        }
      ]
    },
    {
      "name": "3. Users (admin)",
      "item": [
        {
          "name": "POST /users (crear vendedor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.id) {",
                  "  pm.collectionVariables.set('userId', res.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"Mendoza\",\n  \"identityDocument\": \"12345678\",\n  \"phone\": \"987654321\",\n  \"email\": \"carlos@valhalla.com\",\n  \"password\": \"Vendedor123!\",\n  \"roleId\": 2,\n  \"documentTypeId\": 1\n}"
            }
          }
        },
        {
          "name": "GET /users (listar)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users?page=1&limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "GET /users/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "PATCH /users/:id",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"999111222\"\n}"
            }
          }
        },
        {
          "name": "DELETE /users/:id (soft delete)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
