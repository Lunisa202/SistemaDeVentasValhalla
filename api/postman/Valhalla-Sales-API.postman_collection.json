              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"voucherType\": \"RECEIPT\",\n  \"voucherCode\": \"B001-000001\",\n  \"saleChannel\": \"IN_STORE\",\n  \"paymentMethodId\": 1,\n  \"products\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 3\n    }\n  ]\n}"
            }
