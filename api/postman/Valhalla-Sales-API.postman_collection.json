    {
      "name": "10. Error Cases",
      "item": [
        {
          "name": "GET sin token (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "POST login con credenciales incorrectas (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@valhalla.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "POST /products con datos inválidos (400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"code\": \"\",\n  \"salePrice\": -5\n}"
            }
          }
        },
        {
          "name": "GET /users/:id inexistente (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/00000000-0000-0000-0000-000000000000",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "GET ruta inexistente (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ruta-que-no-existe"
          }
        }
      ]
    }
  ]
