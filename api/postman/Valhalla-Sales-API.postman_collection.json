{
  "info": {
    "name": "Valhalla Sales API",
    "description": "Colección de pruebas para la API del Sistema de Ventas Valhalla.\nEjecutar en orden numérico — los scripts guardan IDs automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "companyId", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "productId2", "value": "" },
    { "key": "purchaseId", "value": "" },
    { "key": "saleId", "value": "" },
    { "key": "cashRegisterId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "POST /auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  console.log('Token guardado: ' + res.data.user.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@valhalla.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (credenciales incorrectas) → 401",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@valhalla.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/login (email inválido) → 400",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "POST /auth/logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
