    {
      "name": "8. Purchases (admin)",
      "item": [
        {
          "name": "POST /purchases (compra con detalles)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.purchase && res.data.purchase.id) {",
                  "  pm.collectionVariables.set('purchaseId', res.data.purchase.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/purchases",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerId\": \"{{providerId}}\",\n  \"voucherType\": \"INVOICE\",\n  \"products\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 20,\n      \"unitPrice\": 2.50\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "GET /purchases",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/purchases?page=1&limit=10",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        },
        {
          "name": "GET /purchases/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/purchases/{{purchaseId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ]
          }
        }
      ]
    },
