          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carlos\",\n  \"lastName\": \"Mendoza\",\n  \"identityDocument\": \"12345678\",\n  \"phone\": \"987654321\",\n  \"email\": \"carlos@valhalla.com\",\n  \"password\": \"Vendedor123!\",\n  \"roleId\": 2,\n  \"documentTypeId\": 1\n}"
            }
          }
        },
        {
          "name": "POST /users (email duplicado) → 409",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Otro\",\n  \"lastName\": \"Usuario\",\n  \"identityDocument\": \"99999999\",\n  \"email\": \"carlos@valhalla.com\",\n  \"password\": \"Test123!\",\n  \"roleId\": 2,\n  \"documentTypeId\": 1\n}"
            }
          }
        },
        {
          "name": "GET /users (listar paginado)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users?page=1&limit=10",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "GET /users/:id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "GET /users/:id (no existe) → 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/00000000-0000-0000-0000-000000000000",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "PATCH /users/:id (actualizar teléfono)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"999111222\"\n}" }
          }
        },
        {
          "name": "DELETE /users/:id (soft delete)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },
